{
  "name": "omd",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "description": "oh my day \u2014 a local-first notebook",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.js",
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:slash": "node tests/slash-browser.mjs",
    "test:startup": "node tests/startup.mjs",
    "test:migration": "node tests/record-migration.mjs",
    "test:theme": "node tests/theme-browser.mjs",
    "test:notifications": "node tests/notifications.mjs",
    "test:insertion": "node tests/block-insertion.mjs",
    "test:callout": "node tests/callout-browser.mjs",
    "test:heading": "node tests/heading-browser.mjs",
    "test:checklist": "node tests/checklist-browser.mjs",
    "test:checklist-time": "node tests/checklist-time.mjs",
    "test:editor": "node tests/text-editor.mjs",
    "test:drafts": "node tests/input-drafts.mjs",
    "test:destructive": "node tests/destructive-composition.mjs",
    "test:paste": "node tests/markdown-paste.mjs",
    "test:table": "node tests/table-browser.mjs",
    "test:table-rich": "node tests/table-rich.mjs",
    "test:tabs": "node tests/tabs-drag.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "check:static": "node tests/static-output.mjs",
    "package:release": "node scripts/package-release.mjs && node scripts/package-cloudflare.mjs",
    "test:release": "node tests/release-package.mjs",
    "test:transition": "node tests/editor-transition.mjs",
    "test:diagrams": "node tests/diagram-dependencies.mjs",
    "test:page-drag": "node tests/page-drag.mjs",
    "desktop:prepare": "node --use-env-proxy desktop/prepare.mjs",
    "desktop:dev": "node desktop/run.mjs dev",
    "desktop:build": "node desktop/run.mjs build",
    "test:bridge:browser": "node tests/bridge-browser.mjs",
    "test:desktop": "node desktop/test-native.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc --local",
    "cloudflare:migrate:local": "wrangler d1 migrations apply omd-notebook --config cloudflare/wrangler.jsonc --local",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "test:cloudflare": "node --import tsx tests/cloudflare-limits.mjs && node --import tsx tests/cloudflare.mjs",
    "test:cloudflare:package": "node --import tsx tests/cloudflare-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@orchard/bridge-contract": "https://github.com/and1truong/orchad/releases/download/orchard-v0.1.0/orchard-bridge-contract-0.1.0.tgz",
    "@tiptap/core": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "immer": "11.1.21",
    "mermaid": "12.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.5",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "nanoid@3.3.3": "3.3.20",
    "sass@1.51.0": "1.105.1",
    "lodash-es": "4.18.1",
    "nanoid@4.0.2": "5.1.16",
    "katex": "0.18.2"
  }
}
