{
  "name": "omd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "oh my day \u2014 a local-first notebook",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.js",
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:startup": "node tests/startup.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "check:static": "node tests/static-output.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "immer": "11.1.21",
    "mermaid": "12.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.5",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
